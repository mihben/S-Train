variables:
  SOLUTION_FOLDER: "./src/"
  ARTIFACTS_PATH: "$CI_PROJECT_DIR/artifacts/"

  SONARSCANNER_PATH: "$CI_PROJECT_DIR/.dotnet/tools/sonarscanner"
  SONARSCANNER_KEY: "${CI_COMMIT_SHA}-SONARSCANNER"

  VERSIONIZE_PATH: "$CI_PROJECT_DIR/.dotnet/tools/versionize"
  VERSIONIZE_KEY: "${CI_COMMIT_SHA}-VERSIONIZE"
  
  SONAR_ANALYSIS_DIRECTORY: "$CI_PROJECT_DIR/$SOLUTION_FOLDER/.sonarqube/"

install-sonarscanner:
  stage: .pre
  cache:
    policy: push
    key: "${SONARSCANNER_KEY}"
    paths:
      - "${SONARSCANNER_PATH}"
  script:
    - dotnet tool install --tool-path ${SONARSCANNER_PATH} dotnet-sonarscanner
  # rules:
  #   - if: $CI_COMMIT_BRANCH == "develop" 
  #   - if: $CI_COMMIT_BRANCH == "main" 
  #   - if: $CI_PIPELINE_SOURCE == "merge_request_event"

install-versionize:
  stage: .pre
  cache:
    policy: push
    key: "${VERSIONIZE_KEY}"
    paths:
    - "${VERSIONIZE_PATH}"
  script:
    - dotnet tool install --tool-path ${VERSIONIZE_PATH} Versionize

build-job:       # Building the source code
  stage: build
  cache:
    policy: pull-push
    key: "${SONARSCANNER_KEY}"
    paths:
      - "${SONARSCANNER_PATH}"
      - "${SONAR_ANALYSIS_DIRECTORY}"
  script:
    - cd $SOLUTION_FOLDER
    - export PATH="$PATH:${SONARSCANNER_PATH}"
    - dotnet sonarscanner begin /k:"mihben_strain" /o:"mihben-gitlab" /d:sonar.login="$SONAR_TOKEN" /d:sonar.host.url=https://sonarcloud.io /d:sonar.cs.opencover.reportsPaths=$ARTIFACTS_PATH**/*.opencover.xml /d:sonar.junit.reportPaths=$ARTIFACTS_PATH**/*-test-result.xml
    - dotnet build --configuration Release --output $ARTIFACTS_PATH
  artifacts:
    when: on_success
    expire_in: 1 days
    paths:
      - $ARTIFACTS_PATH
  # rules:
  #   - if: $CI_COMMIT_BRANCH == "develop" 
  #   - if: $CI_COMMIT_BRANCH == "main" 
  #   - if: $CI_PIPELINE_SOURCE == "merge_request_event"

qa-job:
  stage: qa
  script:
    - cd $SOLUTION_FOLDER
    - dotnet test --test-adapter-path:. --logger:"junit;LogFilePath=$ARTIFACTS_PATH\\{assembly}-test-result.xml;MethodFormat=Class;FailureBodyFormat=Verbose" --collect:"XPlat Code Coverage;Format=cobertura,opencover" --results-directory:$ARTIFACTS_PATH
  artifacts:
    when: always
    expire_in: 14 days
    paths:
      - ./**/*test-result.xml
      - ./**/*opencover.xml
    reports:
      junit:
        - ./**/*test-result.xml
      coverage_report:
        coverage_format: cobertura
        path: ./**/*cobertura.xml
  # rules:
  #   - if: $CI_COMMIT_BRANCH == "develop" 
  #   - if: $CI_COMMIT_BRANCH == "main" 
  #   - if: $CI_PIPELINE_SOURCE == "merge_request_event"

sonarcloud-check:
  stage: .post
  cache:
    policy: pull
    key: "${SONARSCANNER_KEY}"
    paths:
      - "${SONARSCANNER_PATH}"
      - $"{SONAR_ANALYSIS_DIRECTORY}"
  when: always
  script:
    - apt-get update && apt-get dist-upgrade -y && apt-get install -y openjdk-11-jre
    - export PATH="$PATH:${SONARSCANNER_PATH}"
    - cd ${SOLUTION_FOLDER}
    - dotnet sonarscanner end /d:sonar.login="$SONAR_TOKEN"
  # rules:
  #   - if: $CI_COMMIT_BRANCH == "develop" 
  #   - if: $CI_COMMIT_BRANCH == "main" 
  #   - if: $CI_PIPELINE_SOURCE == "merge_request_event"
