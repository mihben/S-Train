{

  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "Uri": "https://promtail.mihben.work",
          "PropertiesAsLabels": [
            "Application",
            "Environment",
            "level"
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "S-Train.Sample",
      "Environment": "Production"
    }
  },

    "Senders": {
        "Generic": {
            "BaseAddress": "http://localhost:5100/",
            "Path": "api"
        },
        "External": {
            "BaseAddress": "https://random-data-api.com/"
        }
    },

    "RabbitMQ": {
        "Host": "mihben.site",
        "User": "guest",
        "Password": "guest",
        "Consumer": {
            "Queue": "test-queue",
            "Tag": "STrain.Sample.Dev",
            "Exchange": "test-exchange",
            "RoutingKeys": [ "#" ]
        },
        "Publisher": {
            "Exchange": "test-exchange"
        }
    },

    "KurrentDB": {
        "ConnectionName": "strain.sample",
        "ConnectivitySettings": {
            "Address": "http://mihben.site:2113",
            "TlsVerifyCert": false,
            "Insecure": true
        }
    }
}
